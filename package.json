{
  "name": "claude-tooltip-translate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install --no-audit --no-fund && node scripts/setup.mjs",
    "build": "node scripts/build.mjs",
    "build:personal": "node scripts/build.mjs personal",
    "build:store": "node scripts/build.mjs store",
    "dev": "node scripts/build.mjs personal --watch",
    "check:store": "node scripts/check-store.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test": "npm run test:unit && npm run check:store && npm run test:host && npm run test:e2e",
    "host:install": "node native-host/install.mjs",
    "host:uninstall": "node native-host/install.mjs --uninstall",
    "host:test": "node native-host/host.mjs --selftest",
    "test:host": "node tests/host.test.mjs",
    "bench": "node scripts/bench.mjs",
    "test:unit": "node tests/prompts.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.48.0"
  },
  "description": "웹페이지 단어에 마우스를 올리거나 드래그하면 Claude로 문맥에 맞게 번역해 주는 Chrome 확장",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
